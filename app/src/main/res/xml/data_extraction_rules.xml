<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or transfer the saved credentials, they contain the encryption key -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
